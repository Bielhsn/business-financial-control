# Ambiente: development | staging | production
ENVIRONMENT=development

# API
API_V1_PREFIX=/api/v1
SECRET_KEY=changeme-generate-a-strong-random-secret

# Chave para criptografar segredos de integrações (Hotmart etc.) em repouso.
# Opcional: se ausente, é derivada de SECRET_KEY. Defina uma dedicada em produção.
CONNECTOR_SECRET_KEY=

# Autenticação (Etapa 27)
# Ligue em produção para exigir e-mail confirmado antes do primeiro login.
REQUIRE_EMAIL_VERIFICATION=false
# URL base do FRONTEND (SPA), usada para montar os LINKS de confirmação de e-mail
# e de redefinição de senha enviados por e-mail. Em produção, a URL da Vercel
# (ex.: https://business-financial-control.vercel.app).
APP_BASE_URL=http://localhost:5173
# Provedor de e-mail: "console" (dev, imprime o código no log) ou "resend"
# (envia de verdade via API do Resend; exige RESEND_API_KEY).
EMAIL_PROVIDER=console
# Remetente. Em produção use um e-mail de um domínio validado no Resend.
EMAIL_FROM=Aurum OS <no-reply@aurum.local>
# Chave da API do Resend (https://resend.com → API Keys). Só é usada quando
# EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Login com Google (OAuth). Sem o client id, o endpoint /auth/google responde 503.
GOOGLE_CLIENT_ID=

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=business_financial_control
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Redis (cache, rate limiting)
REDIS_URL=redis://localhost:6379/0

# Logging (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (origens separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Painel administrativo do SaaS (super-admin): e-mails com acesso, separados por
# vírgula. Vazio = ninguém tem acesso ao painel (seguro por padrão).
PLATFORM_ADMIN_EMAILS=

# Senha usada UMA vez pelo script scripts/create_admin.py para criar a conta de
# dono. Deixe vazio em operação normal; passe-a só na hora de rodar o bootstrap
# (ex.: ADMIN_PASSWORD='...' python -m scripts.create_admin --email ...).
ADMIN_PASSWORD=

# URL pública da API — usada para montar o redirect_uri das integrações OAuth
# (o provedor redireciona o navegador de volta para cá).
PUBLIC_BASE_URL=http://localhost:8000

# Credenciais dos apps parceiros das integrações OAuth. Registre cada app no
# provedor e cole client id/secret aqui. Sem elas, o provedor responde 503.
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=

# Provedor de IA (onboarding inteligente, insights)
# Use "anthropic" para habilitar a IA (requer ANTHROPIC_API_KEY com crédito).
# Use "none" (ou qualquer valor != anthropic) para desligar a IA: onboarding e
# insights respondem 503 de forma limpa e o restante do sistema funciona normal.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Cobrança recorrente (Asaas) ---
# Vazio = cobrança desligada: o produto funciona, mas ninguém é cobrado.
# ASAAS_SANDBOX=true usa o ambiente de teste (não cobra de verdade).
#
# O token do webhook é o que separa um webhook de uma porta aberta: sem ele
# configurado, o endpoint recusa TUDO — aceitar aviso não verificado deixaria
# qualquer um marcar a própria assinatura como paga.
# Configure a URL https://SEU-BACKEND/api/v1/billing/webhook e o mesmo token no
# painel do Asaas.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_SANDBOX=true

# --- Sincronização automática das integrações ---
# Intervalo em minutos. 0 = desligada (padrão): sem isto, as vendas só entram
# quando alguém clica em "Sincronizar", e um painel que atualiza quando o dono
# lembra de clicar não é automático.
# Em produção, 60 é um ponto de partida razoável.
#
# Ressalva: o loop roda dentro do processo da API. Com mais de uma instância,
# todas sincronizam — a importação é idempotente, então não corrompe dado, mas
# desperdiça chamada. Nessa escala, migrar para cron externo.
SYNC_INTERVAL_MINUTES=0

# --- Rastreamento de erro (opcional) ---
# Sem isto, exceções ficam só no log do servidor — e log que ninguém lê não
# avisa ninguém. Com o DSN configurado, cada 500 vira alerta.
# Dado pessoal e segredo são filtrados antes do envio (app/core/observability.py).
SENTRY_DSN=
